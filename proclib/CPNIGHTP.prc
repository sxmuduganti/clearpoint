//CPNIGHTP PROC HLQ='CP.PROD',
//             LOADLIB='CP.PROD.LOADLIB',
//             POSTMODE=POSTNORM,
//             DB2SYS=DB2P
//CLEANUP  EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DISP=SHR,DSN=&HLQ..PARMLIB(DELWORK)
//FEEUNL   EXEC PGM=IKJEFT01,DYNAMNBR=20,COND=(4,LT)
//STEPLIB  DD DISP=SHR,DSN=&LOADLIB
//         DD DISP=SHR,DSN=DSN.SDSNLOAD
//SYSTSPRT DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//CTLCARD  DD DISP=SHR,DSN=&HLQ..PARMLIB(DATECARD)
//FEESCHED DD DSN=&HLQ..WORK.FEESCHED,
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(5,5),RLSE),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=0)
//SYSTSIN  DD DISP=SHR,DSN=&HLQ..PARMLIB(FEEUNLTS)
//VALID    EXEC PGM=CPVALID,COND=(4,LT)
//STEPLIB  DD DISP=SHR,DSN=&LOADLIB
//SYSOUT   DD SYSOUT=*
//CTLCARD  DD DISP=SHR,DSN=&HLQ..PARMLIB(DATECARD)
//TRANIN   DD DISP=SHR,DSN=&HLQ..TRANIN(0)
//VALIDOUT DD DSN=&HLQ..WORK.VALID,
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(CYL,(50,25),RLSE),
//            DCB=(RECFM=FB,LRECL=150,BLKSIZE=0)
//REJECTS  DD DSN=&HLQ..WORK.REJVAL,
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(CYL,(5,5),RLSE),
//            DCB=(RECFM=FB,LRECL=210,BLKSIZE=0)
//CTLOUT   DD DSN=&HLQ..WORK.CTLVAL,
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(1,1),RLSE),
//            DCB=(RECFM=FB,LRECL=120,BLKSIZE=0)
//ENRICH   EXEC PGM=CPENRICH,COND=(4,LT)
//STEPLIB  DD DISP=SHR,DSN=&LOADLIB
//SYSOUT   DD SYSOUT=*
//CTLCARD  DD DISP=SHR,DSN=&HLQ..PARMLIB(DATECARD)
//VALIDIN  DD DISP=SHR,DSN=&HLQ..WORK.VALID
//CARDXREF DD DISP=SHR,DSN=&HLQ..CARDXREF,AMP=('BUFND=20,BUFNI=10')
//MERCHMST DD DISP=SHR,DSN=&HLQ..MERCHMST,AMP=('BUFND=20,BUFNI=10')
//ENROUT   DD DSN=&HLQ..WORK.ENRICHED,
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(CYL,(60,30),RLSE),
//            DCB=(RECFM=FB,LRECL=200,BLKSIZE=0)
//REJECTS  DD DSN=&HLQ..WORK.REJENR,
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(CYL,(5,5),RLSE),
//            DCB=(RECFM=FB,LRECL=210,BLKSIZE=0)
//CTLOUT   DD DSN=&HLQ..WORK.CTLENR,
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(1,1),RLSE),
//            DCB=(RECFM=FB,LRECL=120,BLKSIZE=0)
//SORTENR  EXEC PGM=SORT,COND=(4,LT)
//SYSOUT   DD SYSOUT=*
//SORTIN   DD DISP=SHR,DSN=&HLQ..WORK.ENRICHED
//SORTOUT  DD DSN=&HLQ..WORK.ENRSORT,
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(CYL,(60,30),RLSE),
//            DCB=(RECFM=FB,LRECL=200,BLKSIZE=0)
//SYSIN    DD DISP=SHR,DSN=&HLQ..PARMLIB(SORTENR)
//REJSUM   EXEC PGM=ICETOOL,COND=(4,LT)
//TOOLMSG  DD SYSOUT=*
//DFSMSG   DD SYSOUT=*
//REJECTS  DD DISP=SHR,DSN=&HLQ..WORK.REJVAL
//         DD DISP=SHR,DSN=&HLQ..WORK.REJENR
//REJRPT   DD SYSOUT=*
//TOOLIN   DD DISP=SHR,DSN=&HLQ..PARMLIB(REJSUM)
//DELPOST  EXEC PGM=IDCAMS,COND=(4,LT)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DISP=SHR,DSN=&HLQ..PARMLIB(DELPOST)
//POST     EXEC PGM=CPPOST,COND=(4,LT)
//STEPLIB  DD DISP=SHR,DSN=&LOADLIB
//SYSOUT   DD SYSOUT=*
//CTLCARD  DD DISP=SHR,DSN=&HLQ..PARMLIB(DATECARD)
//         DD DISP=SHR,DSN=&HLQ..PARMLIB(&POSTMODE)
//ENRSORT  DD DISP=SHR,DSN=&HLQ..WORK.ENRSORT
//ACCTMAST DD DISP=OLD,DSN=&HLQ..ACCTMAST,
//            AMP=('BUFND=40,BUFNI=20')
//ACCTMAS1 DD DISP=OLD,DSN=&HLQ..ACCTMAST.CUSTPATH
//RSTCTL   DD DISP=OLD,DSN=&HLQ..RSTCTL
//POSTOUT  DD DSN=&HLQ..WORK.POSTED,
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(CYL,(70,35),RLSE),
//            DCB=(RECFM=FB,LRECL=250,BLKSIZE=0)
//SUSPENSE DD DSN=&HLQ..WORK.SUSPENSE,
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(CYL,(5,5),RLSE),
//            DCB=(RECFM=FB,LRECL=250,BLKSIZE=0)
//CTLOUT   DD DSN=&HLQ..WORK.CTLPOST,
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(1,1),RLSE),
//            DCB=(RECFM=FB,LRECL=120,BLKSIZE=0)
//FEECALC  EXEC PGM=CPFEECAL,COND=(4,LT)
//STEPLIB  DD DISP=SHR,DSN=&LOADLIB
//SYSOUT   DD SYSOUT=*
//CTLCARD  DD DISP=SHR,DSN=&HLQ..PARMLIB(DATECARD)
//FEESCHED DD DISP=SHR,DSN=&HLQ..WORK.FEESCHED
//POSTIN   DD DISP=SHR,DSN=&HLQ..WORK.POSTED
//FEEOUT   DD DSN=&HLQ..WORK.FEEDTL,
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(CYL,(40,20),RLSE),
//            DCB=(RECFM=FB,LRECL=150,BLKSIZE=0)
//CTLOUT   DD DSN=&HLQ..WORK.CTLFEE,
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(1,1),RLSE),
//            DCB=(RECFM=FB,LRECL=120,BLKSIZE=0)
//SORTFEE  EXEC PGM=SORT,COND=(4,LT)
//SYSOUT   DD SYSOUT=*
//SORTIN   DD DISP=SHR,DSN=&HLQ..WORK.FEEDTL
//SORTOUT  DD DSN=&HLQ..WORK.FEESORT,
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(CYL,(40,20),RLSE),
//            DCB=(RECFM=FB,LRECL=150,BLKSIZE=0)
//SYSIN    DD DISP=SHR,DSN=&HLQ..PARMLIB(SORTFEE)
//SETTLE   EXEC PGM=CPSETTLE,COND=(4,LT)
//STEPLIB  DD DISP=SHR,DSN=&LOADLIB
//SYSOUT   DD SYSOUT=*
//CTLCARD  DD DISP=SHR,DSN=&HLQ..PARMLIB(DATECARD)
//FEESORT  DD DISP=SHR,DSN=&HLQ..WORK.FEESORT
//SETLOUT  DD DSN=&HLQ..WORK.SETTLE,
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(5,5),RLSE),
//            DCB=(RECFM=FB,LRECL=150,BLKSIZE=0)
//CTLOUT   DD DSN=&HLQ..WORK.CTLSTL,
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(1,1),RLSE),
//            DCB=(RECFM=FB,LRECL=120,BLKSIZE=0)
//RECON    EXEC PGM=CPRECON,COND=(4,LT)
//STEPLIB  DD DISP=SHR,DSN=&LOADLIB
//SYSOUT   DD SYSOUT=*
//CTLCARD  DD DISP=SHR,DSN=&HLQ..PARMLIB(DATECARD)
//CTLIN    DD DISP=SHR,DSN=&HLQ..WORK.CTLVAL
//         DD DISP=SHR,DSN=&HLQ..WORK.CTLENR
//         DD DISP=SHR,DSN=&HLQ..WORK.CTLPOST
//         DD DISP=SHR,DSN=&HLQ..WORK.CTLFEE
//         DD DISP=SHR,DSN=&HLQ..WORK.CTLSTL
//RECONRPT DD DSN=&HLQ..RECONRPT(+1),
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(1,1),RLSE),
//            DCB=(RECFM=FBA,LRECL=133,BLKSIZE=0)
//REPORT   EXEC PGM=CPRPT,COND=((4,LT),(0,LT,RECON))
//STEPLIB  DD DISP=SHR,DSN=&LOADLIB
//SYSOUT   DD SYSOUT=*
//CTLCARD  DD DISP=SHR,DSN=&HLQ..PARMLIB(DATECARD)
//SETLIN   DD DISP=SHR,DSN=&HLQ..WORK.SETTLE
//RPTOUT   DD DSN=&HLQ..SETLRPT(+1),
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(5,5),RLSE),
//            DCB=(RECFM=FBA,LRECL=133,BLKSIZE=0)
//ARCHIVE  EXEC PGM=IDCAMS,COND=((4,LT),(0,LT,RECON))
//SYSPRINT DD SYSOUT=*
//REJIN    DD DISP=SHR,DSN=&HLQ..WORK.REJVAL
//         DD DISP=SHR,DSN=&HLQ..WORK.REJENR
//REJOUT   DD DSN=&HLQ..REJECTS(+1),
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(CYL,(5,5),RLSE),
//            DCB=(RECFM=FB,LRECL=210,BLKSIZE=0)
//SUSIN    DD DISP=SHR,DSN=&HLQ..WORK.SUSPENSE
//SUSOUT   DD DSN=&HLQ..SUSPENSE(+1),
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(CYL,(5,5),RLSE),
//            DCB=(RECFM=FB,LRECL=250,BLKSIZE=0)
//FEEIN    DD DISP=SHR,DSN=&HLQ..WORK.FEEDTL
//FEEOUT   DD DSN=&HLQ..FEEDTL(+1),
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(CYL,(40,20),RLSE),
//            DCB=(RECFM=FB,LRECL=150,BLKSIZE=0)
//STLIN    DD DISP=SHR,DSN=&HLQ..WORK.SETTLE
//STLOUT   DD DSN=&HLQ..SETTLE(+1),
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(5,5),RLSE),
//            DCB=(RECFM=FB,LRECL=150,BLKSIZE=0)
//SYSIN    DD DISP=SHR,DSN=&HLQ..PARMLIB(ARCHIVE)
//         PEND
