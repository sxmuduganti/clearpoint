CPADJM   DFHMSD TYPE=&SYSPARM,MODE=INOUT,LANG=COBOL,CTRL=FREEKB,       X
               STORAGE=AUTO,TIOAPFX=YES,                               X
               MAPATTS=(COLOR,HILIGHT)
CPADJ1   DFHMDI SIZE=(24,80),LINE=1,COLUMN=1
         DFHMDF POS=(1,2),LENGTH=4,ATTRB=(ASKIP,BRT),INITIAL='CPAJ'
         DFHMDF POS=(1,22),LENGTH=36,ATTRB=(ASKIP,BRT),                X
               INITIAL='CLEARPOINT BALANCE ADJUSTMENTS'
CURDATE  DFHMDF POS=(1,69),LENGTH=10,ATTRB=(ASKIP,NORM)
         DFHMDF POS=(3,2),LENGTH=20,ATTRB=(ASKIP,NORM),                X
               INITIAL='FUNCTION  . . . . :'
FUNC     DFHMDF POS=(3,23),LENGTH=1,ATTRB=(UNPROT,IC,FSET),            X
               HILIGHT=UNDERLINE
         DFHMDF POS=(3,25),LENGTH=50,ATTRB=(ASKIP,NORM),               X
               INITIAL='S=SUBMIT  V=VIEW  A=APPROVE  R=REJECT'
         DFHMDF POS=(4,2),LENGTH=20,ATTRB=(ASKIP,NORM),                X
               INITIAL='ADJUSTMENT ID . . :'
ADJID    DFHMDF POS=(4,23),LENGTH=7,ATTRB=(UNPROT,NUM,FSET),           X
               HILIGHT=UNDERLINE
         DFHMDF POS=(4,31),LENGTH=1,ATTRB=ASKIP
         DFHMDF POS=(6,2),LENGTH=20,ATTRB=(ASKIP,NORM),                X
               INITIAL='ACCOUNT NUMBER . . :'
ACCTNO   DFHMDF POS=(6,23),LENGTH=12,ATTRB=(UNPROT,NUM,FSET),          X
               HILIGHT=UNDERLINE
         DFHMDF POS=(6,36),LENGTH=1,ATTRB=ASKIP
         DFHMDF POS=(7,2),LENGTH=20,ATTRB=(ASKIP,NORM),                X
               INITIAL='DEBIT/CREDIT  . . :'
ADJTYPE  DFHMDF POS=(7,23),LENGTH=1,ATTRB=(UNPROT,FSET),               X
               HILIGHT=UNDERLINE
         DFHMDF POS=(7,25),LENGTH=20,ATTRB=(ASKIP,NORM),               X
               INITIAL='D=DEBIT  C=CREDIT'
         DFHMDF POS=(8,2),LENGTH=20,ATTRB=(ASKIP,NORM),                X
               INITIAL='AMOUNT  . . . . . :'
AMOUNT   DFHMDF POS=(8,23),LENGTH=12,ATTRB=(UNPROT,FSET),              X
               HILIGHT=UNDERLINE
         DFHMDF POS=(8,36),LENGTH=1,ATTRB=ASKIP
         DFHMDF POS=(9,2),LENGTH=20,ATTRB=(ASKIP,NORM),                X
               INITIAL='REASON CODE . . . :'
REASON   DFHMDF POS=(9,23),LENGTH=4,ATTRB=(UNPROT,FSET),               X
               HILIGHT=UNDERLINE
         DFHMDF POS=(9,28),LENGTH=40,ATTRB=(ASKIP,NORM),               X
               INITIAL='WAIV  DISP  GOOD  CORR'
         DFHMDF POS=(12,2),LENGTH=20,ATTRB=(ASKIP,NORM),               X
               INITIAL='CURRENT BALANCE . :'
CURBAL   DFHMDF POS=(12,23),LENGTH=15,ATTRB=(ASKIP,BRT)
         DFHMDF POS=(13,2),LENGTH=20,ATTRB=(ASKIP,NORM),               X
               INITIAL='ADJUSTMENT STATUS :'
ADJSTAT  DFHMDF POS=(13,23),LENGTH=10,ATTRB=(ASKIP,BRT)
         DFHMDF POS=(14,2),LENGTH=20,ATTRB=(ASKIP,NORM),               X
               INITIAL='SUBMITTED BY  . . :'
MAKER    DFHMDF POS=(14,23),LENGTH=8,ATTRB=(ASKIP,BRT)
         DFHMDF POS=(15,2),LENGTH=20,ATTRB=(ASKIP,NORM),               X
               INITIAL='REVIEWED BY . . . :'
CHECKER  DFHMDF POS=(15,23),LENGTH=8,ATTRB=(ASKIP,BRT)
MSG      DFHMDF POS=(22,2),LENGTH=78,ATTRB=(ASKIP,BRT),COLOR=RED
         DFHMDF POS=(24,2),LENGTH=40,ATTRB=(ASKIP,NORM),               X
               INITIAL='ENTER=PROCESS  PF3=EXIT  CLEAR=EXIT'
         DFHMSD TYPE=FINAL
         END
