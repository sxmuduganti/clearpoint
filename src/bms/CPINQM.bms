CPINQM   DFHMSD TYPE=&SYSPARM,MODE=INOUT,LANG=COBOL,CTRL=FREEKB,       X
               STORAGE=AUTO,TIOAPFX=YES,                               X
               MAPATTS=(COLOR,HILIGHT)
CPINQ1   DFHMDI SIZE=(24,80),LINE=1,COLUMN=1
         DFHMDF POS=(1,2),LENGTH=4,ATTRB=(ASKIP,BRT),INITIAL='CPIN'
         DFHMDF POS=(1,25),LENGTH=30,ATTRB=(ASKIP,BRT),                X
               INITIAL='CLEARPOINT ACCOUNT INQUIRY'
CURDATE  DFHMDF POS=(1,69),LENGTH=10,ATTRB=(ASKIP,NORM)
         DFHMDF POS=(3,2),LENGTH=20,ATTRB=(ASKIP,NORM),                X
               INITIAL='ACCOUNT NUMBER . . :'
ACCTNO   DFHMDF POS=(3,23),LENGTH=12,ATTRB=(UNPROT,NUM,IC,FSET),       X
               HILIGHT=UNDERLINE
         DFHMDF POS=(3,36),LENGTH=1,ATTRB=ASKIP
         DFHMDF POS=(5,2),LENGTH=20,ATTRB=(ASKIP,NORM),                X
               INITIAL='CUSTOMER ID . . . :'
CUSTID   DFHMDF POS=(5,23),LENGTH=10,ATTRB=(ASKIP,BRT)
         DFHMDF POS=(6,2),LENGTH=20,ATTRB=(ASKIP,NORM),                X
               INITIAL='PRODUCT . . . . . :'
PRODUCT  DFHMDF POS=(6,23),LENGTH=4,ATTRB=(ASKIP,BRT)
         DFHMDF POS=(7,2),LENGTH=20,ATTRB=(ASKIP,NORM),                X
               INITIAL='STATUS  . . . . . :'
ACSTAT   DFHMDF POS=(7,23),LENGTH=15,ATTRB=(ASKIP,BRT)
         DFHMDF POS=(8,2),LENGTH=20,ATTRB=(ASKIP,NORM),                X
               INITIAL='OPENED  . . . . . :'
OPENDT   DFHMDF POS=(8,23),LENGTH=10,ATTRB=(ASKIP,BRT)
         DFHMDF POS=(10,2),LENGTH=20,ATTRB=(ASKIP,NORM),               X
               INITIAL='CREDIT LIMIT  . . :'
CRLIMIT  DFHMDF POS=(10,23),LENGTH=15,ATTRB=(ASKIP,BRT)
         DFHMDF POS=(11,2),LENGTH=20,ATTRB=(ASKIP,NORM),               X
               INITIAL='CURRENT BALANCE . :'
CURBAL   DFHMDF POS=(11,23),LENGTH=15,ATTRB=(ASKIP,BRT)
         DFHMDF POS=(12,2),LENGTH=20,ATTRB=(ASKIP,NORM),               X
               INITIAL='AVAILABLE CREDIT  :'
AVAIL    DFHMDF POS=(12,23),LENGTH=15,ATTRB=(ASKIP,BRT)
         DFHMDF POS=(13,2),LENGTH=20,ATTRB=(ASKIP,NORM),               X
               INITIAL='CASH LIMIT  . . . :'
CASHLIM  DFHMDF POS=(13,23),LENGTH=15,ATTRB=(ASKIP,BRT)
         DFHMDF POS=(14,2),LENGTH=20,ATTRB=(ASKIP,NORM),               X
               INITIAL='CASH BALANCE  . . :'
CASHBAL  DFHMDF POS=(14,23),LENGTH=15,ATTRB=(ASKIP,BRT)
         DFHMDF POS=(16,2),LENGTH=20,ATTRB=(ASKIP,NORM),               X
               INITIAL='CYCLE PURCHASES . :'
CTDPUR   DFHMDF POS=(16,23),LENGTH=15,ATTRB=(ASKIP,BRT)
         DFHMDF POS=(17,2),LENGTH=20,ATTRB=(ASKIP,NORM),               X
               INITIAL='CYCLE CREDITS . . :'
CTDCRD   DFHMDF POS=(17,23),LENGTH=15,ATTRB=(ASKIP,BRT)
         DFHMDF POS=(18,2),LENGTH=20,ATTRB=(ASKIP,NORM),               X
               INITIAL='LAST POSTED . . . :'
LSTPOST  DFHMDF POS=(18,23),LENGTH=10,ATTRB=(ASKIP,BRT)
MSG      DFHMDF POS=(22,2),LENGTH=78,ATTRB=(ASKIP,BRT),COLOR=RED
         DFHMDF POS=(24,2),LENGTH=40,ATTRB=(ASKIP,NORM),               X
               INITIAL='ENTER=INQUIRE  PF3=EXIT  CLEAR=EXIT'
         DFHMSD TYPE=FINAL
         END
