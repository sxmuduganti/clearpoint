//CPLOAD   JOB (CP00,SETUP),'CLEARPOINT MASTER LOAD',
//             CLASS=A,MSGCLASS=X,MSGLEVEL=(1,1),
//             NOTIFY=&SYSUID
//SORTACCT EXEC PGM=SORT
//SYSOUT   DD SYSOUT=*
//SORTIN   DD DISP=SHR,DSN=CP.CONV.ACCTEXT
//SORTOUT  DD DSN=&&ACCTSRT,DISP=(NEW,PASS),
//            SPACE=(CYL,(50,25),RLSE),
//            DCB=(RECFM=FB,LRECL=200,BLKSIZE=0)
//SYSIN    DD *
  SORT FIELDS=(1,12,CH,A)
  SUM FIELDS=NONE
/*
//LOADACCT EXEC PGM=CPMSTLD,COND=(0,LT)
//STEPLIB  DD DISP=SHR,DSN=CP.PROD.LOADLIB
//SYSOUT   DD SYSOUT=*
//CTLCARD  DD *
LOAD=ACCOUNTS
/*
//ACCTIN   DD DSN=&&ACCTSRT,DISP=(OLD,DELETE)
//ACCTMAST DD DISP=OLD,DSN=CP.PROD.ACCTMAST
//ACCTMAS1 DD DISP=OLD,DSN=CP.PROD.ACCTMAST.CUSTPATH
//SORTCARD EXEC PGM=SORT,COND=(4,LT)
//SYSOUT   DD SYSOUT=*
//SORTIN   DD DISP=SHR,DSN=CP.CONV.CARDXREF
//SORTOUT  DD DSN=&&CARDSRT,DISP=(NEW,PASS),
//            SPACE=(CYL,(20,10),RLSE),
//            DCB=(RECFM=FB,LRECL=50,BLKSIZE=0)
//SYSIN    DD *
  SORT FIELDS=(1,16,CH,A)
/*
//LOADCARD EXEC PGM=CPMSTLD,COND=(4,LT)
//STEPLIB  DD DISP=SHR,DSN=CP.PROD.LOADLIB
//SYSOUT   DD SYSOUT=*
//CTLCARD  DD *
LOAD=CARDS
/*
//CARDIN   DD DSN=&&CARDSRT,DISP=(OLD,DELETE)
//CARDXREF DD DISP=OLD,DSN=CP.PROD.CARDXREF
//SORTMERC EXEC PGM=SORT,COND=(4,LT)
//SYSOUT   DD SYSOUT=*
//SORTIN   DD DISP=SHR,DSN=CP.CONV.MERCHANT
//SORTOUT  DD DSN=&&MERCSRT,DISP=(NEW,PASS),
//            SPACE=(CYL,(5,5),RLSE),
//            DCB=(RECFM=FB,LRECL=100,BLKSIZE=0)
//SYSIN    DD *
  SORT FIELDS=(1,15,CH,A)
/*
//LOADMERC EXEC PGM=CPMSTLD,COND=(4,LT)
//STEPLIB  DD DISP=SHR,DSN=CP.PROD.LOADLIB
//SYSOUT   DD SYSOUT=*
//CTLCARD  DD *
LOAD=MERCHANTS
/*
//MERCHIN  DD DSN=&&MERCSRT,DISP=(OLD,DELETE)
//MERCHMST DD DISP=OLD,DSN=CP.PROD.MERCHMST
//LISTCAT  EXEC PGM=IDCAMS,COND=(4,LT)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
  LISTCAT ENTRIES(CP.PROD.ACCTMAST -
                  CP.PROD.CARDXREF -
                  CP.PROD.MERCHMST) -
          ALL
/*
