//CPONLBLD JOB (CP00,BUILD),'CLEARPOINT ONLINE BUILD',
//             CLASS=A,MSGCLASS=X,MSGLEVEL=(1,1),
//             NOTIFY=&SYSUID
//PROCS    JCLLIB ORDER=(DFH620.CICS.SDFHPROC)
//COBCICS  PROC MEM=,OPTS='CICS',
//             SRCLIB='CP.PROD.SOURCE',
//             CPYLIB='CP.PROD.COPYLIB',
//             DCLLIB='CP.PROD.DCLGEN',
//             DBRMLIB='CP.PROD.DBRMLIB',
//             LOADLIB='CP.PROD.CICS.LOADLIB'
//COBOL    EXEC PGM=IGYCRCTL,
//             PARM=('&OPTS,LIB,APOST,RENT,OPT(2)',
//             'TRUNC(OPT),NUMPROC(PFD),XREF,MAP,LIST')
//STEPLIB  DD DISP=SHR,DSN=IGY.V6R4M0.SIGYCOMP
//         DD DISP=SHR,DSN=DFH620.CICS.SDFHLOAD
//         DD DISP=SHR,DSN=DSN.SDSNLOAD
//SYSIN    DD DISP=SHR,DSN=&SRCLIB(&MEM)
//SYSLIB   DD DISP=SHR,DSN=&CPYLIB
//         DD DISP=SHR,DSN=&DCLLIB
//         DD DISP=SHR,DSN=DFH620.CICS.SDFHCOB
//DBRMLIB  DD DISP=SHR,DSN=&DBRMLIB(&MEM)
//SYSPRINT DD SYSOUT=*
//SYSLIN   DD DSN=&&OBJ,DISP=(NEW,PASS),
//            SPACE=(CYL,(1,1)),UNIT=SYSALLDA
//SYSUT1   DD SPACE=(CYL,(1,1)),UNIT=SYSALLDA
//SYSUT2   DD SPACE=(CYL,(1,1)),UNIT=SYSALLDA
//SYSUT3   DD SPACE=(CYL,(1,1)),UNIT=SYSALLDA
//SYSUT4   DD SPACE=(CYL,(1,1)),UNIT=SYSALLDA
//SYSUT5   DD SPACE=(CYL,(1,1)),UNIT=SYSALLDA
//SYSUT6   DD SPACE=(CYL,(1,1)),UNIT=SYSALLDA
//SYSUT7   DD SPACE=(CYL,(1,1)),UNIT=SYSALLDA
//SYSUT8   DD SPACE=(CYL,(1,1)),UNIT=SYSALLDA
//SYSUT9   DD SPACE=(CYL,(1,1)),UNIT=SYSALLDA
//SYSUT10  DD SPACE=(CYL,(1,1)),UNIT=SYSALLDA
//SYSUT11  DD SPACE=(CYL,(1,1)),UNIT=SYSALLDA
//SYSUT12  DD SPACE=(CYL,(1,1)),UNIT=SYSALLDA
//SYSUT13  DD SPACE=(CYL,(1,1)),UNIT=SYSALLDA
//SYSUT14  DD SPACE=(CYL,(1,1)),UNIT=SYSALLDA
//SYSUT15  DD SPACE=(CYL,(1,1)),UNIT=SYSALLDA
//SYSMDECK DD SPACE=(CYL,(1,1)),UNIT=SYSALLDA
//LKED     EXEC PGM=IEWL,COND=(4,LT,COBOL),
//             PARM='LIST,XREF,RENT,AMODE=31,RMODE=ANY'
//SYSLIB   DD DISP=SHR,DSN=DFH620.CICS.SDFHLOAD
//         DD DISP=SHR,DSN=CEE.SCEELKED
//         DD DISP=SHR,DSN=DSN.SDSNLOAD
//SYSLIN   DD DISP=SHR,DSN=DFH620.CICS.SDFHSAMP(DFHEILID)
//         DD DSN=&&OBJ,DISP=(OLD,DELETE)
//         DD DDNAME=SYSIN
//SYSLMOD  DD DISP=SHR,DSN=&LOADLIB(&MEM)
//SYSPRINT DD SYSOUT=*
//SYSUT1   DD SPACE=(CYL,(1,1)),UNIT=SYSALLDA
//         PEND
//INQMAP   EXEC DFHMAPS,MAPNAME=CPINQM,
//             MAPLIB='CP.PROD.CICS.LOADLIB',
//             DSCTLIB='CP.PROD.COPYLIB'
//COPY.SYSUT1 DD DISP=SHR,DSN=CP.PROD.SOURCE(CPINQM)
//ADJMAP   EXEC DFHMAPS,MAPNAME=CPADJM,
//             MAPLIB='CP.PROD.CICS.LOADLIB',
//             DSCTLIB='CP.PROD.COPYLIB'
//COPY.SYSUT1 DD DISP=SHR,DSN=CP.PROD.SOURCE(CPADJM)
//CPINQ    EXEC COBCICS,MEM=CPINQ
//CPACCAPI EXEC COBCICS,MEM=CPACCAPI
//CPADJ    EXEC COBCICS,MEM=CPADJ,OPTS='CICS,SQL'
//BINDADJ  EXEC PGM=IKJEFT01,COND=(4,LT)
//STEPLIB  DD DISP=SHR,DSN=DSN.SDSNLOAD
//DBRMLIB  DD DISP=SHR,DSN=CP.PROD.DBRMLIB
//SYSTSPRT DD SYSOUT=*
//SYSTSIN  DD *
  DSN SYSTEM(DB2P)
  BIND PACKAGE(CPCOLL) MEMBER(CPADJ) -
       OWNER(CPADMIN) QUALIFIER(CPPROD) -
       ISOLATION(CS) CURRENTDATA(NO) -
       VALIDATE(BIND) ACTION(REPLACE) -
       EXPLAIN(YES)
  BIND PLAN(CPONLINE) PKLIST(CPCOLL.*) -
       OWNER(CPADMIN) ACTION(REPLACE) -
       ACQUIRE(USE) RELEASE(COMMIT)
  END
/*
